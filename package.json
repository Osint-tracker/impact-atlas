{
  "name": "risiko-offline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:react": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:ui": "node scripts/browser-test.mjs",
    "benchmark:ai": "node scripts/benchmark-ai.mjs",
    "benchmark:planner": "node scripts/benchmark-planner.mjs",
    "benchmark:arena": "node scripts/benchmark-arena.mjs",
    "ios:setup": "node scripts/ios-setup.mjs",
    "ios:sync": "node scripts/ios-setup.mjs",
    "ios:open": "cap open ios",
    "ios:verify": "node scripts/verify-ios.mjs",
    "test:pwa": "node scripts/pwa-test.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs",
    "benchmark:progression": "node scripts/benchmark-progression.mjs"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3",
    "vite": "7.0.0",
    "playwright": "1.57.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
