# =====================================================================
# Impact Atlas -- environment configuration template.
# Copy to `.env` and fill in the values required by the stages you run.
# Never commit the real `.env` file or any API key to git.
# =====================================================================

# --- Required by map_loader.py (NASA FIRMS thermal detections) -------
FIRMS_API_KEY=

# --- Required by the AI analysis tier (scripts/ai_agent.py, etc.) ----
OPENROUTER_API_KEY=
# Optional: OpenAI direct key (used together with the fine-tuned Titan
# model). Only needed when TITAN_MODEL_ID points at an OpenAI model.
OPENAI_API_KEY=
# Optional override for the fine-tuned scoring model id.
TITAN_MODEL_ID=

# --- Required by the raw-signal ingestion tier ------------------------
# war_tracker_v2/scripts2/fetch_telegram.py (Telethon credentials).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- Optional integrations -------------------------------------------
# Campaign definitions Google Sheet (CSV export URL of the sheet).
SHEET_CSV_URL=
# Path to the Google service-account JSON used by
# scripts/update_gsheet_campaigns.py. Keep the file outside the repo.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: GitHub token for scripts/ingest_owl_db.py (Project Owl ORBAT).
GITHUB_TOKEN=

# --- Runtime tuning (sensible defaults; all optional) ----------------
# IMPACT_ATLAS_REQUEST_TIMEOUT_SECONDS=30
# IMPACT_ATLAS_MAX_RETRIES=3
# IMPACT_ATLAS_RETRY_BACKOFF_SECONDS=1.5
# IMPACT_ATLAS_USER_AGENT=ImpactAtlas/2.0
